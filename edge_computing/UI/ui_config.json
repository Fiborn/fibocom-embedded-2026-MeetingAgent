{
  "llm_model": "qwen",
  "timezone": "Asia/Shanghai",
  "license_dir": "../qcom_6490_license",
  "speaker_id_dir": "speech",
  "mic": {
    "capture_backend": "alsa",
    "alsa_device": "hw:1,0",
    "device_index": 0,
    "channels": 4,
    "primary_channel": 0,
    "sample_rate": 16000,
    "frames": 2048,
    "auto_detect_dov": true
  },
  "speaker": {
    "use_doa": true,
    "doa_min_conf": 0.55,
    "doa_diff_deg": 45,
    "doa_weight": 0.22,
    "same_threshold": 0.54,
    "new_threshold": 0.38,
    "sticky_min_sim": 0.46,
    "rematch_min": 0.50,
    "freq_weight": 0.14,
    "merge_threshold": 0.64,
    "enroll_match_threshold": 0.40,
    "enroll_match_floor": 0.34,
    "enroll_match_margin": 0.08
  },
  "asr": {
    "vad_threshold": 0.15,
    "min_silence_duration": 0.55,
    "min_speech_duration": 0.30,
    "target_rms": 0.10,
    "max_gain": 12.0,
    "adaptive_primary": true,
    "use_best_channel": true,
    "channel_mix": false,
    "post_correct": true,
    "queue_max": 12,
    "short_merge_max_sec": 0.90
  },
  "llm_worker": {
    "warmup_on_start": true,
    "transcript_max_lines": 30,
    "transcript_max_chars": 2800,
    "merge_same_speaker": true,
    "request_timeout_sec": 900,
    "warmup_timeout_sec": 180,
    "refine_timeout_sec": 300,
    "progress_heartbeat_sec": 30
  },
  "meeting_extract": {
    "mode": "rules_llm",
    "llm_refine": "auto",
    "preview_rules_first": true,
    "refine_snippet_max_chars": 400
  },
  "harness": {
    "enabled": true,
    "enhance_extract": true,
    "write_memory_on_end": true,
    "backend": "auto",
    "top_k": 5,
    "query_chars": 800,
    "min_chars": 20,
    "memory_tags": ["meeting", "ui"],
    "search_timeout_sec": 30,
    "write_timeout_sec": 120
  }
}
